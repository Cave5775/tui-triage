/* triage board theme: Textual design variables only, so light and dark themes both work. */

Screen {
    background: $background;
}

#topbar {
    height: 2;
    background: $panel;
}

#repo {
    height: 1;
    width: 1fr;
    background: $panel-darken-1;
}

#tabs {
    width: 1fr;
    height: 1;
    background: $panel;
}

#main {
    height: 1fr;
}

#left {
    width: 55%;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    border-title-style: bold;
}

#left:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

#filter {
    margin: 0;
    padding: 0 1;
    background: $boost;
    border: none;
    height: 1;
}

#items {
    height: 1fr;
    border: none;
    padding: 0;
    background: transparent;
}

#items > .option-list--option {
    padding: 0 1;
}

#items > .option-list--option-highlighted {
    background: $primary 35%;
    color: $text;
    text-style: bold;
}

#items:focus > .option-list--option-highlighted {
    background: $primary 70%;
    color: $text;
    text-style: bold;
}

#items > .option-list--option-hover {
    background: $boost;
}

#detail {
    width: 1fr;
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    border-title-style: bold;
    padding: 0 1;
    background: transparent;
}

#detail:focus {
    border: round $accent;
    border-title-color: $accent;
}

#message {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
}

#message.-error {
    color: $error;
    text-style: bold;
}

#hints {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ---- modals --------------------------------------------------------------- */

ModalScreen {
    background: $background 40%;
}

QuickAddScreen, PromptScreen {
    align: left bottom;
    background: transparent;
}

#quickadd, #prompt {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: $panel;
    border-top: solid $primary;
}

#quickadd-preview, #prompt-title {
    height: 1;
    color: $text-muted;
}

#quickadd Input, #prompt Input {
    height: 1;
    border: none;
    padding: 0;
    background: $boost;
}

ConfirmScreen {
    align: center middle;
}

#confirm {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $error;
}

#confirm-hint {
    margin-top: 1;
    color: $text-muted;
}

HelpScreen, SettingsScreen, RepoPickerScreen, ItemFormScreen {
    align: center middle;
}

#help {
    width: 76;
    max-width: 96%;
    height: 90%;
    padding: 1 2;
    background: $panel;
    border: round $primary;
    border-title-color: $primary;
}

#settings {
    width: 100;
    max-width: 98%;
    height: 80%;
    background: $panel;
    border: round $primary;
    border-title-color: $primary;
}

#settings-table {
    height: 1fr;
    scrollbar-size-horizontal: 0;
    background: transparent;
}

#settings-help {
    height: 1;
    padding: 0 1;
}

#settings-msg {
    height: 1;
    padding: 0 1;
}

#settings-input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $boost;
}

#picker {
    width: 100;
    max-width: 98%;
    height: 70%;
    background: $panel;
    border: round $primary;
    border-title-color: $primary;
}

#picker-input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $boost;
}

#picker-list {
    height: 1fr;
    border: none;
    background: transparent;
}

#picker-msg {
    height: 1;
    padding: 0 1;
}

#form {
    width: 90;
    max-width: 98%;
    height: auto;
    max-height: 95%;
    padding: 0 2;
    background: $panel;
    border: round $primary;
    border-title-color: $primary;
}

#form Label {
    color: $text-muted;
    margin-top: 1;
}

#form-row {
    height: auto;
}

#form-row > Vertical {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

#f-body {
    height: 10;
}

#form-error {
    height: 1;
}

/* ---- add / edit form: choice fields, hint line, compact mode ---- */

#form {
    width: 90;
    max-width: 100%;
    padding: 0 1;
}

#form ChoiceField {
    margin-top: 0;
    background: $boost;
    color: $text;
}

#form ChoiceField:hover {
    background: $primary 30%;
}

#form ChoiceField:focus {
    background: $primary;
    color: $text;
    text-style: bold;
}

#form-hint {
    height: auto;
    color: $text-muted;
}

ItemFormScreen.-compact #form Label {
    margin-top: 0;
}

ItemFormScreen.-compact #f-body {
    height: 5;
}
